      "original_function": "static int feas(int tok, int corb) {\n    int hist[6] = {0, 0, 0, 0, 0, 0};\n    for (int q = 0; q < NQ2; ++q) {\n        if (!ocnt[q] || q == corb) continue;\n        hist[5 - ocnt[q]]++;\n    }\n    int tot = 0, left = tok;\n    for (int d = 4; d >= 1; --d) {\n        int take = hist[d] < left ? hist[d] : left;\n        left -= take;\n        tot += (hist[d] - take) * d;\n    }\n    return tot <= DM;\n}",
      "mathematical_condition": "TOP_K_ERASURE_LOWER_BOUND <= DMAX"
    },
